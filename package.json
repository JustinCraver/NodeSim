{
  "name": "nodesim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "coverage": "node scripts/coverage.mjs",
    "fixtures:semantic": "vitest run tests/semanticFixtures.test.ts",
    "benchmark:large-graph": "vitest run tests/largeGraphBenchmark.test.ts --reporter=verbose",
    "build": "vite build",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "smoke:deployed": "node scripts/deployed-smoke.mjs",
    "deps:duplicates": "node scripts/dependency-majors.mjs",
    "deps:audit": "npm audit --audit-level=high",
    "deps:outdated": "npm outdated",
    "deps:licenses": "node scripts/license-check.mjs",
    "release:package": "node scripts/create-release.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run bundle:check",
    "ci:verify": "npm run typecheck && npm run lint && npm test && npm run coverage && npm run deps:duplicates && npm run build && npm run bundle:check && npm run smoke:deployed",
    "preview": "vite preview"
  },
  "dependencies": {
    "cytoscape": "^3.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^4.5.5",
    "vitest": "0.34.6"
  },
  "allowScripts": {
    "esbuild@0.18.20": true
  }
}
