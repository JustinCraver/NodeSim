{
  "name": "econgraph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:semantic": "vitest run tests/semanticFixtures.test.ts",
    "benchmark:large-graph": "vitest run tests/largeGraphBenchmark.test.ts --reporter=verbose",
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cytoscape": "^3.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "react-resizable": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^4.5.5",
    "vitest": "0.34.6"
  },
  "allowScripts": {
    "esbuild@0.18.20": true
  }
}
